# Copier en .env puis renseigner. Le fichier .env est ignoré par git.

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# Voix ElevenLabs (facultatif : sinon config.json > voice.voiceId).
# Lister les voix du compte : node 01_voice.js --list-voices
ELEVENLABS_VOICE_ID=

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=...
